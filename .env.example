# Copy this file to .env and fill it in. .env is gitignored; this file is not,
# so it must never contain a real value.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres. Free connection strings from:
#   Neon      https://neon.tech        (recommended — serverless, generous free tier)
#   Supabase  https://supabase.com
#   Vercel    the Storage tab in your project
#
# DATABASE_URL is the POOLED string, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL is the same string with `-pooler` removed from the host.
# Migrations need a direct connection: a transaction-mode pooler can't run DDL
# or hold the advisory locks Prisma Migrate takes out.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""

# Local development only. On Vercel, LEAVE THIS UNSET — Auth.js derives its URL
# from the request host (trustHost is on) and emailed links use
# VERCEL_PROJECT_PRODUCTION_URL. Setting it to localhost on a deployment sends
# every sign-in redirect and every emailed link to localhost, which fails
# quietly: nobody notices until an invitation cannot be accepted.
AUTH_URL="http://localhost:3000"

# ── Email ───────────────────────────────────────────────────────────────────
# Transactional email. The outbox keeps this behind one function, so swapping
# providers touches lib/email/provider.ts and nothing else.
# Without a key the dispatcher logs instead of sending, and development works.
RESEND_API_KEY=""
EMAIL_FROM="ServiceOps <onboarding@resend.dev>"

# Shared secret for the notification dispatcher and reminder crons.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ── AI (Module 2) ───────────────────────────────────────────────────────────
# Google Gemini — free tier, no card needed. https://aistudio.google.com/apikey
# Without it every AI feature stays cleanly disabled and the app behaves as
# Module 1 — no errors, no broken screens.
GEMINI_API_KEY=""
# Optional. `npm run ai:models` lists what your key can actually reach.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional. Requests per minute per organization; stays under the free-tier cap.
# AI_RATE_LIMIT_PER_MINUTE="15"
